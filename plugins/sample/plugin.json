{
  "id": "org.adws.sample.HelloWorld",
  "name": "plugin.name",
  "version": "1.0.0",
  "entry": "main.py",
  "renderer": "panel.text-v1",
  "adws": {
    "api": 1,
    "minVersion": "1.25"
  },
  "defaults": {
    "interval": 5
  },
  "settingsSchema": [
    {
      "key": "greeting",
      "label": "settings.greeting",
      "type": "string",
      "default": "Hello ADWS"
    },
    {
      "key": "enabled",
      "label": "settings.enabled",
      "type": "boolean",
      "default": true
    }
  ]
}
