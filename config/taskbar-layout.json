{
  "apiVersion": 1,
  "comment": "底部任务栏组件布局。内置组件与 .mplg 插件都按 slot + order 渲染。",
  "builtins": [
    {
      "id": "start",
      "enabled": true,
      "slot": "left",
      "order": 0
    },
    {
      "id": "windows",
      "enabled": true,
      "slot": "left",
      "order": 1
    },
    {
      "id": "workspaces",
      "enabled": true,
      "slot": "right",
      "order": 1
    },
    {
      "id": "clock",
      "enabled": true,
      "slot": "right",
      "order": 2
    }
  ],
  "plugins": [
    {
      "package": "org.AkiACG_Community.NCMLyricsBar",
      "enabled": true,
      "slot": "right",
      "order": 0,
      "width": 0,
      "animations": true,
      "settings": {
        "font_family": "",
        "primary_color": "",
        "secondary_color": "",
        "separator_color": "",
        "offset_ms": 0.0,
        "experimental_other_platforms": false,
        "api_mode": "netease",
        "api_url": "",
        "lyric_path": "lrc.lyric",
        "translation_path": "tlyric.lyric"
      }
    }
  ],
  "options": {
    "taskbar_library": null,
    "desktop_space_library": "/home/akizuki/.local/lib/waybar/libwaybar-space.so",
    "keep_live_base": true,
    "start_label": "",
    "start_icon_mode": "custom",
    "start_launcher_command": "rofi -show drun -theme-str 'mainbox { background-image: none; }'",
    "start_launcher_custom": "rofi -show drun -theme-str 'mainbox { background-image: none; }'",
    "start_image": "/home/akizuki/MNWS/samples/start-buttons/popcat/closed.png",
    "start_hover_image": "/home/akizuki/MNWS/samples/start-buttons/popcat/open.png",
    "position": "bottom",
    "thickness": 36,
    "window_rows": 1,
    "animation_duration": 280,
    "group_windows": true,
    "window_animations": true,
    "tab_animations": true,
    "hover_color": "#241f31",
    "focus_color": "",
    "focus_text_color": "",
    "urgent_color": ""
  }
}
