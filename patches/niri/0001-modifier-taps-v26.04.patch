diff --git a/src/input/modifier_tap.rs b/src/input/modifier_tap.rs
new file mode 100644
index 0000000..dff6cdb
--- /dev/null
+++ b/src/input/modifier_tap.rs
@@ -0,0 +1,158 @@
+//! ADWS optional modifier taps. Presses and releases remain client events;
+//! actions run once after an otherwise unused key is released.
+use niri_config::{Bind, ModKey, Modifiers, Trigger};
+use smithay::backend::input::Keycode;
+use smithay::input::keyboard::{Keysym, ModifiersState};
+use std::collections::HashSet;
+
+#[derive(Default)]
+pub struct ModifierTap {
+    held: HashSet<Keycode>,
+    pending: Option<(Keycode, Bind)>,
+}
+impl ModifierTap {
+    pub fn key_event(&mut self, code: Keycode, pressed: bool) -> bool {
+        if pressed {
+            let alone = self.held.is_empty();
+            // Another press (including key repetition) invalidates a tap.
+            self.cancel();
+            self.held.insert(code);
+            alone
+        } else {
+            self.held.remove(&code);
+            false
+        }
+    }
+    pub fn arm(&mut self, code: Keycode, bind: Bind) {
+        self.pending = Some((code, bind));
+    }
+    pub fn cancel(&mut self) {
+        self.pending = None;
+    }
+    pub fn finish(&mut self, code: Keycode) -> Option<Bind> {
+        match self.pending.take() {
+            Some((pending, bind)) if pending == code && self.held.is_empty() => Some(bind),
+            _ => None,
+        }
+    }
+}
+
+pub fn find_bind(
+    binds: &[Bind],
+    mod_key: ModKey,
+    key: Keysym,
+    mods: ModifiersState,
+    inhibited: bool,
+) -> Option<Bind> {
+    let modifier = match key {
+        Keysym::Super_L | Keysym::Super_R => Modifiers::SUPER,
+        Keysym::Control_L | Keysym::Control_R => Modifiers::CTRL,
+        Keysym::Shift_L | Keysym::Shift_R => Modifiers::SHIFT,
+        Keysym::Alt_L | Keysym::Alt_R => Modifiers::ALT,
+        Keysym::ISO_Level3_Shift => Modifiers::ISO_LEVEL3_SHIFT,
+        Keysym::ISO_Level5_Shift => Modifiers::ISO_LEVEL5_SHIFT,
+        _ => return None,
+    };
+    // This compatibility patch deliberately supports standalone taps only.
+    let mut others = super::modifiers_from_state(mods);
+    others.remove(modifier);
+    if !others.is_empty() {
+        return None;
+    }
+    binds
+        .iter()
+        .find(|bind| {
+            let Trigger::Modifier(trigger) = bind.key.trigger else {
+                return false;
+            };
+            let matches = trigger == modifier
+                || (trigger == Modifiers::COMPOSITOR && modifier == mod_key.to_modifiers());
+            matches && bind.key.modifiers.is_empty() && !(inhibited && bind.allow_inhibiting)
+        })
+        .cloned()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use niri_config::{Action, Key};
+    fn binding() -> Bind {
+        Bind {
+            key: Key {
+                trigger: Trigger::Modifier(Modifiers::CTRL),
+                modifiers: Modifiers::empty(),
+            },
+            action: Action::ToggleOverview,
+            repeat: true,
+            cooldown: None,
+            allow_when_locked: false,
+            allow_inhibiting: true,
+            hotkey_overlay_title: None,
+        }
+    }
+    #[test]
+    fn adws_tap_runs_once_on_release() {
+        let mut tap = ModifierTap::default();
+        let ctrl = Keycode::from(37u32);
+        assert!(tap.key_event(ctrl, true));
+        tap.arm(ctrl, binding());
+        assert!(tap.pending.is_some());
+        tap.key_event(ctrl, false);
+        assert!(tap.finish(ctrl).is_some());
+        assert!(tap.finish(ctrl).is_none());
+    }
+    #[test]
+    fn adws_combinations_never_become_taps() {
+        for ctrl_first in [true, false] {
+            let mut tap = ModifierTap::default();
+            let ctrl = Keycode::from(37u32);
+            let c = Keycode::from(54u32);
+            if ctrl_first {
+                assert!(tap.key_event(ctrl, true));
+                tap.arm(ctrl, binding());
+                assert!(!tap.key_event(c, true));
+                tap.key_event(c, false);
+            } else {
+                tap.key_event(c, true);
+                assert!(!tap.key_event(ctrl, true));
+                tap.key_event(c, false);
+            }
+            tap.key_event(ctrl, false);
+            assert!(tap.finish(ctrl).is_none());
+        }
+    }
+    #[test]
+    fn adws_cancel_mouse_or_repeat() {
+        let mut tap = ModifierTap::default();
+        let ctrl = Keycode::from(37u32);
+        for repeat in [false, true] {
+            tap.key_event(ctrl, true);
+            tap.arm(ctrl, binding());
+            if repeat {
+                tap.key_event(ctrl, true);
+            } else {
+                tap.cancel();
+            }
+            tap.key_event(ctrl, false);
+            assert!(tap.finish(ctrl).is_none());
+        }
+    }
+    #[test]
+    fn adws_inhibition_and_other_modifiers() {
+        let binds = [binding()];
+        let mods = ModifiersState {
+            ctrl: true,
+            ..Default::default()
+        };
+        assert!(find_bind(&binds, ModKey::Super, Keysym::Control_L, mods, false).is_some());
+        assert!(find_bind(&binds, ModKey::Super, Keysym::Control_R, mods, true).is_none());
+        assert!(find_bind(
+            &binds,
+            ModKey::Super,
+            Keysym::Control_L,
+            ModifiersState { alt: true, ..mods },
+            false
+        )
+        .is_none());
+    }
+}
